# ============================================================
# Modelo de variáveis de ambiente
# Copie para .env.local e preencha os valores
# ============================================================

# --- Banco de dados ---
DATABASE_URL=mysql://user:password@host:3306/database

# --- Segurança ---
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# --- Login local (para ambientes sem OAuth) ---
# Em desenvolvimento (NODE_ENV=development) é ativado automaticamente
LOCAL_LOGIN_ENABLED=true
LOCAL_LOGIN_PASSWORD=admin123

# --- Identificação da aplicação ---
VITE_APP_ID=financeiro-local
OWNER_OPEN_ID=local:admin   # openId do usuário que receberá role=admin

# --- OAuth externo (deixe em branco para usar login local) ---
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
