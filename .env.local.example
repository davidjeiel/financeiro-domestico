# ============================================================
# Copie este arquivo para .env.local e ajuste os valores
# O arquivo .env.local NÃO é versionado (ver .gitignore)
# ============================================================

# Banco de dados
# - Rodando via Podman (compose.yaml): o hostname é sobrescrito para "db" automaticamente
# - Rodando localmente (pnpm dev): use "localhost"
DATABASE_URL=mysql://fiscaluser:fiscal123@localhost:3306/financeiro

# Segredo JWT para assinar tokens de sessão
# Em produção, use um valor longo e aleatório (ex: openssl rand -hex 32)
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Login local — habilitar somente em desenvolvimento
# Deixe LOCAL_LOGIN_ENABLED=false (ou remova) em produção
LOCAL_LOGIN_ENABLED=true
LOCAL_LOGIN_PASSWORD=admin123

# Identificação da aplicação e usuário administrador local
VITE_APP_ID=financeiro-local
OWNER_OPEN_ID=local:admin

# OAuth externo (Google, etc.)
# Deixe em branco para usar o login local
# Preencha para habilitar "Entrar com Google"
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
