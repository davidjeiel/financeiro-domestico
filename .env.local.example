# ============================================================
# Copie este arquivo para .env.local e ajuste os valores
# O arquivo .env.local NÃO é versionado (ver .gitignore)
# ============================================================

# OAuth Client ID do Google (tipo "Aplicativo da Web").
# Não há backend nem banco de dados: o navegador faz login com o Google e
# grava os dados em uma planilha no Google Drive do próprio usuário.
# Veja no README como criar o Client ID.
VITE_GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
